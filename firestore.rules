rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Helper: check if user is owner
    function isOwner() {
      return isAuth() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }
    
    // Helper: check if user is manager or above
    function isManager() {
      return isAuth() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }

    // Products Collection — authenticated read, manager+ write
    match /products/{productId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }
    
    // Suppliers Collection
    match /suppliers/{supplierId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }
    
    // Customers Collection
    match /customers/{customerId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }
    
    // Resellers Collection
    match /resellers/{resellerId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }
    
    // Sales Collection
    match /sales/{saleId} {
      allow read: if isAuth();
      allow create: if isManager();
      allow update, delete: if isOwner();
    }
    
    // Purchase Orders Collection
    match /purchaseOrders/{orderId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }
    
    // Testers Collection
    match /testers/{testerId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }
    
    // Stock Movements Collection
    match /stockMovements/{movementId} {
      allow read: if isAuth();
      allow create: if isManager();
      allow delete: if isOwner();
    }
    
    // Counters Collection (invoice/order numbering)
    match /counters/{counterId} {
      allow read: if isAuth();
      allow write: if isManager();
      // Guest checkout may only allocate the next order number with a new order.
      allow get: if counterId.matches('order-[0-9]{4}');
      allow create, update: if counterId.matches('order-[0-9]{4}')
        && request.resource.data.keys().hasOnly(['seq', 'orderId'])
        && request.resource.data.seq is int
        && request.resource.data.seq == (exists(/databases/$(database)/documents/counters/$(counterId)) ? resource.data.seq + 1 : 1)
        && request.resource.data.orderId is string
        && !exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.counterId == counterId
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.orderSequence == request.resource.data.seq;
    }
    
    // Settings Collection
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isOwner();
    }
    
    // Users Collection — can only read others, can ONLY update own name (not role)
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth();
      // Users can only update their own doc, and NEVER the role field
      allow update: if isAuth() && request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      // Only owner can delete users
      allow delete: if isOwner();
    }
    
    // Analytics Collection (page/product view tracking)
    match /analytics/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
    
    // Newsletter Collection
    match /newsletter/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
    
    // Test Collection (connection checks)
    match /test/{docId} {
      allow read, write: if true;
    }

    // Contacts Collection
    match /contacts/{contactId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isManager();
    }

    // Orders Collection (website orders)
    match /orders/{orderId} {
      allow read: if isAuth();
      // Staff may create an order directly; website guests must match the strict shape below.
      allow create: if isManager();
      allow create: if request.resource.data.keys().hasOnly([
          'customerName', 'email', 'phone', 'address', 'city', 'province', 'zipCode',
          'notes', 'items', 'subtotal', 'total', 'OrderNumber', 'counterId',
          'orderSequence', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.counterId.matches('order-[0-9]{4}')
        && getAfter(/databases/$(database)/documents/counters/$(request.resource.data.counterId)).data.orderId == orderId
        && getAfter(/databases/$(database)/documents/counters/$(request.resource.data.counterId)).data.seq == request.resource.data.orderSequence;
      allow update: if isManager();
      allow delete: if isOwner();
    }

    // Audit Log Collection
    match /auditLog/{logId} {
      allow read: if isManager();
      allow create: if isAuth();
      allow update, delete: if false;
    }
  }
}
