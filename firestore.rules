rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Helper: check if user is owner
    function isOwner() {
      return isAuth() && request.auth.uid == '6aOu6pgtNuOWfxbKGMP4UMUCcb';
    }
    
    // Helper: check if user is manager or above
    function isManager() {
      return isAuth() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }

    // Products Collection — authenticated read, manager+ write
    match /products/{productId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }

    // Supply records used by the Vessa-inspired admin workspace.
    match /rawMaterials/{materialId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }

    match /storageLocations/{locationId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }
    
    // Suppliers Collection
    match /suppliers/{supplierId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }
    
    // Customers Collection
    match /customers/{customerId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }
    
    // Resellers Collection
    match /resellers/{resellerId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }
    
    // Sales Collection
    match /sales/{saleId} {
      allow read: if isAuth();
      allow create: if isManager();
      allow update, delete: if isOwner();
    }
    
    // Purchase Orders Collection
    match /purchaseOrders/{orderId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }
    
    // Testers Collection
    match /testers/{testerId} {
      allow read: if isAuth();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }
    
    // Stock Movements Collection
    match /stockMovements/{movementId} {
      allow read: if isAuth();
      allow create: if isManager();
      allow delete: if isOwner();
    }
    
    // Counters Collection (invoice/order numbering)
    match /counters/{counterId} {
      allow read: if isAuth();
      allow write: if isManager();
      // Guest checkout may only allocate the next order number with a new order.
      allow get: if counterId.matches('order-[0-9]{4}');
      allow create, update: if counterId.matches('order-[0-9]{4}')
        && request.resource.data.keys().hasOnly(['seq', 'orderId'])
        && request.resource.data.seq is int
        && request.resource.data.seq == (exists(/databases/$(database)/documents/counters/$(counterId)) ? resource.data.seq + 1 : 1)
        && request.resource.data.orderId is string
        && !exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.counterId == counterId
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.orderSequence == request.resource.data.seq;
    }
    
    // Settings Collection
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isOwner();
    }
    
    // Roles can only be self-provisioned at the least-privileged level, except
    // for the two explicitly provisioned staff accounts.
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isOwner());
      allow create: if isAuth()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['role', 'email', 'createdAt', 'name', 'displayName'])
        && ((request.auth.uid == '6aOu6pgtNuOWfxbKGMP4UMUCcb' && request.resource.data.role == 'owner')
          || (request.auth.uid == 'qS5tyNyVFehRVleY7Y4HHScqKPu1' && request.resource.data.role == 'manager')
          || request.resource.data.role == 'employee');
      allow update: if (isAuth() && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || (isOwner() && request.resource.data.role in ['employee', 'manager', 'owner']);
      allow delete: if isOwner();
    }
    
    // Analytics Collection (page/product view tracking)
    // Guests may create a view event; only staff may read the numbers.
    match /analytics/{docId} {
      allow read: if isAuth();
      allow create: if request.resource.data.keys().hasOnly(['timestamp', 'page'])
                    && request.resource.data.page is string
                    && request.resource.data.page.size() <= 100;
      allow update, delete: if isAuth();
    }

    // Analytics sub-collection (real path: analytics/pageViews/{id})
    match /analytics/{docId}/{subId} {
      allow read: if isAuth();
      allow create: if request.resource.data.keys().hasOnly(['timestamp', 'page'])
                    && request.resource.data.page is string
                    && request.resource.data.page.size() <= 100;
      allow update, delete: if isAuth();
    }
    
    // Newsletter Collection
    // Guests may subscribe; only staff may read the list.
    match /newsletter/{docId} {
      allow read: if isAuth();
      allow create: if request.resource.data.keys().hasOnly(['email', 'timestamp', 'source'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 120;
      allow update, delete: if isAuth();
    }
    
    // Test Collection (connection checks)
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Contacts Collection
    match /contacts/{contactId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isManager();
    }

    // Orders Collection (website orders)
    match /orders/{orderId} {
      allow read: if isAuth();
      // Staff may create an order directly; website guests must match the strict shape below.
      allow create: if isManager();
      allow create: if request.resource.data.keys().hasOnly([
          'customerName', 'email', 'phone', 'address', 'city', 'province', 'zipCode',
          'notes', 'items', 'subtotal', 'total', 'OrderNumber', 'counterId',
          'orderSequence', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.counterId.matches('order-[0-9]{4}')
        && getAfter(/databases/$(database)/documents/counters/$(request.resource.data.counterId)).data.orderId == orderId
        && getAfter(/databases/$(database)/documents/counters/$(request.resource.data.counterId)).data.seq == request.resource.data.orderSequence;
      allow update: if isManager();
      allow delete: if isOwner();
    }

    // Audit Log Collection
    match /auditLog/{logId} {
      allow read: if isManager();
      allow create: if isAuth();
      allow update, delete: if false;
    }
  }
}
